generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Ticket {
  id            Int          @id @default(autoincrement())
  ticketId      String?      @unique // e.g. TKT-001, set right after insert
  customerName  String
  customerEmail String
  subject       String
  description   String
  status        TicketStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  notes         Note[]

  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
}

model Note {
  id        Int      @id @default(autoincrement())
  ticketRef Int
  ticket    Ticket   @relation(fields: [ticketRef], references: [id], onDelete: Cascade)
  noteText  String
  createdAt DateTime @default(now())

  @@index([ticketRef])
}
